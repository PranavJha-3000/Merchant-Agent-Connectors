# Merchant Agent Connectors — environment template
# Copy to .env (git-ignored) and fill in real values ONLY for live mode.
# The default mode is "fixture": the full test suite and demo run with NO credentials.

CONNECTOR_MODE=fixture

# --- Freshdesk (live mode only) ---------------------------------------------
# Source: https://developers.freshdesk.com/api/#authentication
# Auth: HTTP Basic with your API key as the username and any string as password.
# Domain = the subdomain of your helpdesk, e.g. "acme" for acme.freshdesk.com.
FRESHDESK_DOMAIN=
FRESHDESK_API_KEY=

# --- WooCommerce (live mode only) -------------------------------------------
# Source: https://developer.woocommerce.com/docs/apis/rest-api/authentication/
# Auth: HTTP Basic (consumer key = username, consumer secret = password) over
#       HTTPS only. Create a READ-ONLY key in the store admin under
#       WooCommerce > Settings > Advanced > REST API.
# Base URL = the store origin, e.g. "https://shop.example.com" - no path,
#            no trailing slash, and NO http:// (plain HTTP would need OAuth
#            1.0a, which V1 deliberately does not implement).
WOOCOMMERCE_BASE_URL=
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=
